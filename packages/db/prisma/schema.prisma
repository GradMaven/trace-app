// TRACE database schema.
//
// Phase 1 scope: identity, tenancy, RBAC, sessions, magic-link auth, invitations,
// and the tamper-evident audit log. Later phases add supply chain, carbon,
// evidence, trust, compliance, and audit workspace models.
//
// Conventions (docs/data-model.md):
//   - uuid primary keys, column `id`
//   - every tenant-owned row carries `organizationId`
//   - snake_case table/column names via @@map / @map
//   - append-only audit_log; RLS on unambiguously tenant-owned tables (0001_rls)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum MagicLinkPurpose {
  login
  invite

  @@map("magic_link_purpose")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum SupplierStatus {
  active
  archived

  @@map("supplier_status")
}

enum SupplierRequestKind {
  sustainability_questionnaire

  @@map("supplier_request_kind")
}

enum SupplierRequestStatus {
  draft
  sent
  in_progress
  submitted
  accepted
  declined

  @@map("supplier_request_status")
}

enum EvidenceType {
  supplier_report
  invoice
  utility_bill
  certificate
  epd
  lca
  audit_report
  questionnaire
  erp_record
  logistics_record
  contract
  external_dataset

  @@map("evidence_type")
}

model Organization {
  id                    String             @id @default(uuid()) @db.Uuid
  slug                  String             @unique
  legalName             String             @map("legal_name")
  country               String             @db.Char(2)
  baseCurrency          String             @default("EUR") @map("base_currency") @db.Char(3)
  reportingPeriodConfig Json               @default("{}") @map("reporting_period_config")
  status                OrganizationStatus @default(active)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  businessUnits BusinessUnit[]
  memberships   Membership[]
  roles         Role[]
  invitations   Invitation[]
  sessions      Session[]
  suppliers     Supplier[]

  @@map("organization")
}

model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       BusinessUnit?  @relation("BusinessUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     BusinessUnit[] @relation("BusinessUnitTree")

  @@index([organizationId, name])
  @@map("business_unit")
}

/// Platform-level identity. A person; may hold memberships in several organizations.
model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String
  status     String   @default("active")
  mfaEnabled Boolean  @default(false) @map("mfa_enabled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     Membership[]
  sessions        Session[]
  sentInvitations Invitation[] @relation("InvitationInvitedBy")

  @@map("user")
}

/// User <-> Organization link. The tenant-scoped identity.
/// `supplierId` set => a supplier-portal user scoped to that one supplier.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  supplierId     String?          @map("supplier_id") @db.Uuid
  status         MembershipStatus @default(invited)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([supplierId])
  @@map("membership")
}

/// Named bundle of permissions. `organizationId` null => platform role.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String   @default("")
  isPlatform     Boolean  @default(false) @map("is_platform")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, key])
  @@map("role")
}

/// Global permission catalog. Rows mirror @trace/shared PERMISSIONS.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permission")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role")
}

/// Server-side session for cookie auth. `tokenHash` = sha256 of the opaque cookie value.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  mfaPassed      Boolean   @default(false) @map("mfa_passed")
  ip             String?
  userAgentHash  String?   @map("user_agent_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// One-time email token for passwordless login and invitation acceptance.
model MagicLinkToken {
  id           String           @id @default(uuid()) @db.Uuid
  email        String
  tokenHash    String           @unique @map("token_hash")
  purpose      MagicLinkPurpose
  invitationId String?          @map("invitation_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?        @map("consumed_at") @db.Timestamptz(6)

  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@map("magic_link_token")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  roleKeys        String[]         @map("role_keys")
  supplierId      String?          @map("supplier_id") @db.Uuid
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  status          InvitationStatus @default(pending)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tokens       MagicLinkToken[]

  @@index([organizationId, status])
  @@index([email])
  @@index([supplierId])
  @@map("invitation")
}

/// Append-only, hash-chained activity log (ADR-004). No updates or deletes:
/// enforced by 0002_audit_log_guard (trigger) and revoked privileges in prod.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  before         Json?
  after          Json?
  requestId      String   @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  prevHash       String   @map("prev_hash")
  hash           String   @map("hash")

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

/// One row per audit scope (organization id as text, or "platform"). Locked
/// `FOR UPDATE` during an append so the hash chain is serialized per scope.
model AuditHead {
  scope     String   @id
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("audit_head")
}

// ---------------------------------------------------------------------------
// Phase 2 — Supplier Intelligence
// ---------------------------------------------------------------------------

model Supplier {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String
  country         String         @db.Char(2)
  industryNace    String?        @map("industry_nace")
  registrationIds Json           @default("{}") @map("registration_ids")
  status          SupplierStatus @default(active)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     SupplierContact[]
  locations    SupplierLocation[]
  relationship SupplierRelationship?
  requests     SupplierRequest[]
  evidenceRefs SupplierEvidenceRef[]
  passports    SupplierPassport[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId, name])
  @@index([organizationId, status])
  @@map("supplier")
}

model SupplierContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  email          String
  name           String
  role           String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, email])
  @@index([organizationId, supplierId])
  @@map("supplier_contact")
}

model SupplierLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  kind           String   @default("site")
  label          String
  country        String   @db.Char(2)
  address        Json     @default("{}")
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId, supplierId])
  @@map("supplier_location")
}

model SupplierRelationship {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  supplierId     String    @unique @map("supplier_id") @db.Uuid
  category       String?
  tier           Int?
  annualSpend    Decimal?  @map("annual_spend") @db.Decimal(18, 2)
  currency       String    @default("EUR") @db.Char(3)
  since          DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("supplier_relationship")
}

/// An information request sent to a supplier. Phase 2: a fixed sustainability
/// questionnaire. `responses` is keyed by question id (see @trace/domain).
model SupplierRequest {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  supplierId        String                @map("supplier_id") @db.Uuid
  kind              SupplierRequestKind   @default(sustainability_questionnaire)
  templateVersion   String                @map("template_version")
  title             String
  message           String?
  status            SupplierRequestStatus @default(draft)
  dueOn             DateTime?             @map("due_on") @db.Date
  responses         Json                  @default("{}")
  createdByUserId   String                @map("created_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?             @map("sent_at") @db.Timestamptz(6)
  submittedAt       DateTime?             @map("submitted_at") @db.Timestamptz(6)
  submittedByUserId String?               @map("submitted_by_user_id") @db.Uuid
  reviewedAt        DateTime?             @map("reviewed_at") @db.Timestamptz(6)

  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evidenceRefs SupplierEvidenceRef[]

  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@map("supplier_request")
}

/// Lightweight evidence pointer submitted by a supplier. Phase 3 links these to
/// real Document + Evidence records; for now it captures the claim + a URL/note.
model SupplierEvidenceRef {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  supplierId        String       @map("supplier_id") @db.Uuid
  requestId         String?      @map("request_id") @db.Uuid
  type              EvidenceType
  title             String
  sourceUrl         String?      @map("source_url")
  note              String?
  reportingPeriod   String?      @map("reporting_period")
  verified          Boolean      @default(false)
  submittedByUserId String       @map("submitted_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  request  SupplierRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organizationId, supplierId])
  @@map("supplier_evidence_ref")
}

/// Versioned, append-only aggregated snapshot of a supplier's sustainability
/// profile (brief Module C). `data` is the PassportData from @trace/domain.
model SupplierPassport {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  version          Int
  builderVersion   String   @map("builder_version")
  completeness     Int
  data             Json
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  computedByUserId String?  @map("computed_by_user_id") @db.Uuid

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, version])
  @@index([organizationId, supplierId])
  @@map("supplier_passport")
}
