// TRACE database schema.
//
// Phase 1 scope: identity, tenancy, RBAC, sessions, magic-link auth, invitations,
// and the tamper-evident audit log. Later phases add supply chain, carbon,
// evidence, trust, compliance, and audit workspace models.
//
// Conventions (docs/data-model.md):
//   - uuid primary keys, column `id`
//   - every tenant-owned row carries `organizationId`
//   - snake_case table/column names via @@map / @map
//   - append-only audit_log; RLS on unambiguously tenant-owned tables (0001_rls)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum MagicLinkPurpose {
  login
  invite

  @@map("magic_link_purpose")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

model Organization {
  id                    String             @id @default(uuid()) @db.Uuid
  slug                  String             @unique
  legalName             String             @map("legal_name")
  country               String             @db.Char(2)
  baseCurrency          String             @default("EUR") @map("base_currency") @db.Char(3)
  reportingPeriodConfig Json               @default("{}") @map("reporting_period_config")
  status                OrganizationStatus @default(active)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  businessUnits BusinessUnit[]
  memberships   Membership[]
  roles         Role[]
  invitations   Invitation[]
  sessions      Session[]

  @@map("organization")
}

model BusinessUnit {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       BusinessUnit?  @relation("BusinessUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     BusinessUnit[] @relation("BusinessUnitTree")

  @@index([organizationId, name])
  @@map("business_unit")
}

/// Platform-level identity. A person; may hold memberships in several organizations.
model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String
  status     String   @default("active")
  mfaEnabled Boolean  @default(false) @map("mfa_enabled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     Membership[]
  sessions        Session[]
  sentInvitations Invitation[] @relation("InvitationInvitedBy")

  @@map("user")
}

/// User <-> Organization link. The tenant-scoped identity.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(invited)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

/// Named bundle of permissions. `organizationId` null => platform role.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String   @default("")
  isPlatform     Boolean  @default(false) @map("is_platform")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, key])
  @@map("role")
}

/// Global permission catalog. Rows mirror @trace/shared PERMISSIONS.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permission")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role")
}

/// Server-side session for cookie auth. `tokenHash` = sha256 of the opaque cookie value.
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  mfaPassed      Boolean  @default(false) @map("mfa_passed")
  ip             String?
  userAgentHash  String?  @map("user_agent_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// One-time email token for passwordless login and invitation acceptance.
model MagicLinkToken {
  id           String           @id @default(uuid()) @db.Uuid
  email        String
  tokenHash    String           @unique @map("token_hash")
  purpose      MagicLinkPurpose
  invitationId String?          @map("invitation_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?        @map("consumed_at") @db.Timestamptz(6)

  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@map("magic_link_token")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  roleKeys        String[]         @map("role_keys")
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  status          InvitationStatus @default(pending)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  tokens       MagicLinkToken[]

  @@index([organizationId, status])
  @@index([email])
  @@map("invitation")
}

/// Append-only, hash-chained activity log (ADR-004). No updates or deletes:
/// enforced by 0002_audit_log_guard (trigger) and revoked privileges in prod.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  before         Json?
  after          Json?
  requestId      String   @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  prevHash       String   @map("prev_hash")
  hash           String   @map("hash")

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

/// One row per audit scope (organization id as text, or "platform"). Locked
/// `FOR UPDATE` during an append so the hash chain is serialized per scope.
model AuditHead {
  scope     String   @id
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("audit_head")
}
