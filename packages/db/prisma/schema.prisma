// TRACE database schema.
//
// Phase 1 scope: identity, tenancy, RBAC, sessions, magic-link auth, invitations,
// and the tamper-evident audit log. Later phases add supply chain, carbon,
// evidence, trust, compliance, and audit workspace models.
//
// Conventions (docs/data-model.md):
//   - uuid primary keys, column `id`
//   - every tenant-owned row carries `organizationId`
//   - snake_case table/column names via @@map / @map
//   - append-only audit_log; RLS on unambiguously tenant-owned tables (0001_rls)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum MagicLinkPurpose {
  login
  invite

  @@map("magic_link_purpose")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum SupplierStatus {
  active
  archived

  @@map("supplier_status")
}

enum SupplierRequestKind {
  sustainability_questionnaire

  @@map("supplier_request_kind")
}

enum SupplierRequestStatus {
  draft
  sent
  in_progress
  submitted
  accepted
  declined

  @@map("supplier_request_status")
}

enum EvidenceType {
  supplier_report
  invoice
  utility_bill
  certificate
  epd
  lca
  audit_report
  questionnaire
  erp_record
  logistics_record
  contract
  external_dataset

  @@map("evidence_type")
}

model Organization {
  id                    String             @id @default(uuid()) @db.Uuid
  slug                  String             @unique
  legalName             String             @map("legal_name")
  country               String             @db.Char(2)
  baseCurrency          String             @default("EUR") @map("base_currency") @db.Char(3)
  reportingPeriodConfig Json               @default("{}") @map("reporting_period_config")
  status                OrganizationStatus @default(active)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  businessUnits   BusinessUnit[]
  memberships     Membership[]
  roles           Role[]
  invitations     Invitation[]
  sessions        Session[]
  suppliers       Supplier[]
  documents       Document[]
  evidence        Evidence[]
  datapoints      Datapoint[]
  emissionFactors EmissionFactor[]
  activityData    ActivityData[]
  calculations    Calculation[]
  emissions       Emission[]
  aiJobs          AiJob[]
  trustScores     TrustScore[]
  qualityIssues   DataQualityIssue[]
  anomalies       Anomaly[]
  qualityScans    QualityScan[]
  complianceControls  ComplianceControl[]
  complianceMappings  ComplianceMapping[]
  disclosureStatuses  DisclosureStatusRecord[]
  complianceRuns      ComplianceRun[]
  audits              Audit[]
  auditFindings       AuditFinding[]
  auditSimulationRuns AuditSimulationRun[]
  auditPackages       AuditPackage[]
  askQueries          AskQuery[]
  procurementScenarios ProcurementScenario[]
  integrations        Integration[]
  integrationRuns     IntegrationRun[]

  @@map("organization")
}

model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       BusinessUnit?  @relation("BusinessUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     BusinessUnit[] @relation("BusinessUnitTree")

  @@index([organizationId, name])
  @@map("business_unit")
}

/// Platform-level identity. A person; may hold memberships in several organizations.
model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String
  status     String   @default("active")
  mfaEnabled Boolean  @default(false) @map("mfa_enabled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     Membership[]
  sessions        Session[]
  sentInvitations Invitation[] @relation("InvitationInvitedBy")

  @@map("user")
}

/// User <-> Organization link. The tenant-scoped identity.
/// `supplierId` set => a supplier-portal user scoped to that one supplier.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  supplierId     String?          @map("supplier_id") @db.Uuid
  status         MembershipStatus @default(invited)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([supplierId])
  @@map("membership")
}

/// Named bundle of permissions. `organizationId` null => platform role.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String   @default("")
  isPlatform     Boolean  @default(false) @map("is_platform")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, key])
  @@map("role")
}

/// Global permission catalog. Rows mirror @trace/shared PERMISSIONS.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permission")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role")
}

/// Server-side session for cookie auth. `tokenHash` = sha256 of the opaque cookie value.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  mfaPassed      Boolean   @default(false) @map("mfa_passed")
  ip             String?
  userAgentHash  String?   @map("user_agent_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// One-time email token for passwordless login and invitation acceptance.
model MagicLinkToken {
  id           String           @id @default(uuid()) @db.Uuid
  email        String
  tokenHash    String           @unique @map("token_hash")
  purpose      MagicLinkPurpose
  invitationId String?          @map("invitation_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?        @map("consumed_at") @db.Timestamptz(6)

  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@map("magic_link_token")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  roleKeys        String[]         @map("role_keys")
  supplierId      String?          @map("supplier_id") @db.Uuid
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  status          InvitationStatus @default(pending)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tokens       MagicLinkToken[]

  @@index([organizationId, status])
  @@index([email])
  @@index([supplierId])
  @@map("invitation")
}

/// Append-only, hash-chained activity log (ADR-004). No updates or deletes:
/// enforced by 0002_audit_log_guard (trigger) and revoked privileges in prod.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  before         Json?
  after          Json?
  requestId      String   @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  prevHash       String   @map("prev_hash")
  hash           String   @map("hash")

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

/// One row per audit scope (organization id as text, or "platform"). Locked
/// `FOR UPDATE` during an append so the hash chain is serialized per scope.
model AuditHead {
  scope     String   @id
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("audit_head")
}

// ---------------------------------------------------------------------------
// Phase 2 — Supplier Intelligence
// ---------------------------------------------------------------------------

model Supplier {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String
  country         String         @db.Char(2)
  industryNace    String?        @map("industry_nace")
  registrationIds Json           @default("{}") @map("registration_ids")
  status          SupplierStatus @default(active)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     SupplierContact[]
  locations    SupplierLocation[]
  relationship SupplierRelationship?
  requests     SupplierRequest[]
  evidenceRefs SupplierEvidenceRef[]
  passports    SupplierPassport[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId, name])
  @@index([organizationId, status])
  @@map("supplier")
}

model SupplierContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  email          String
  name           String
  role           String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, email])
  @@index([organizationId, supplierId])
  @@map("supplier_contact")
}

model SupplierLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  kind           String   @default("site")
  label          String
  country        String   @db.Char(2)
  address        Json     @default("{}")
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId, supplierId])
  @@map("supplier_location")
}

model SupplierRelationship {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  supplierId     String    @unique @map("supplier_id") @db.Uuid
  category       String?
  tier           Int?
  annualSpend    Decimal?  @map("annual_spend") @db.Decimal(18, 2)
  currency       String    @default("EUR") @db.Char(3)
  since          DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("supplier_relationship")
}

/// An information request sent to a supplier. Phase 2: a fixed sustainability
/// questionnaire. `responses` is keyed by question id (see @trace/domain).
model SupplierRequest {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  supplierId        String                @map("supplier_id") @db.Uuid
  kind              SupplierRequestKind   @default(sustainability_questionnaire)
  templateVersion   String                @map("template_version")
  title             String
  message           String?
  status            SupplierRequestStatus @default(draft)
  dueOn             DateTime?             @map("due_on") @db.Date
  responses         Json                  @default("{}")
  createdByUserId   String                @map("created_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?             @map("sent_at") @db.Timestamptz(6)
  submittedAt       DateTime?             @map("submitted_at") @db.Timestamptz(6)
  submittedByUserId String?               @map("submitted_by_user_id") @db.Uuid
  reviewedAt        DateTime?             @map("reviewed_at") @db.Timestamptz(6)

  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evidenceRefs SupplierEvidenceRef[]

  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@map("supplier_request")
}

/// Lightweight evidence pointer submitted by a supplier. Phase 3 links these to
/// real Document + Evidence records; for now it captures the claim + a URL/note.
model SupplierEvidenceRef {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  supplierId         String       @map("supplier_id") @db.Uuid
  requestId          String?      @map("request_id") @db.Uuid
  documentId         String?      @map("document_id") @db.Uuid
  promotedEvidenceId String?      @map("promoted_evidence_id") @db.Uuid
  type               EvidenceType
  title              String
  sourceUrl          String?      @map("source_url")
  note               String?
  reportingPeriod    String?      @map("reporting_period")
  verified           Boolean      @default(false)
  submittedByUserId  String       @map("submitted_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier         Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  request          SupplierRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  document         Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  promotedEvidence Evidence?        @relation("EvidenceFromSupplierRef", fields: [promotedEvidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, supplierId])
  @@map("supplier_evidence_ref")
}

// ---------------------------------------------------------------------------
// Phase 3 — Evidence Infrastructure
// ---------------------------------------------------------------------------

enum Provenance {
  measured
  supplier_reported
  calculated
  estimated
  modeled
  inferred

  @@map("provenance")
}

enum DataLabel {
  ai_extracted
  human_reviewed
  verified

  @@map("data_label")
}

enum EvidenceStatus {
  uploaded
  processing
  extracted
  reviewed
  verified
  rejected
  expired
  superseded

  @@map("evidence_status")
}

enum DocumentProcessingStatus {
  received
  scanned
  failed

  @@map("document_processing_status")
}

enum ScanStatus {
  pending
  clean
  infected
  skipped

  @@map("scan_status")
}

/// A stored file. Content-addressed by `checksumSha256`; `storageKey` is opaque
/// and never exposed — downloads go through a short-lived signed URL.
model Document {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  filename         String
  mime             String
  sizeBytes        Int                      @map("size_bytes")
  checksumSha256   String                   @map("checksum_sha256")
  storageKey       String                   @map("storage_key")
  storageDriver    String                   @map("storage_driver")
  version          Int                      @default(1)
  processingStatus DocumentProcessingStatus @default(received) @map("processing_status")
  scanStatus       ScanStatus               @default(pending) @map("scan_status")
  retentionUntil   DateTime?                @map("retention_until") @db.Date
  uploadedByUserId String                   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     Evidence[]
  supplierRefs SupplierEvidenceRef[]
  extraction   DocumentExtraction?
  candidates   CandidateDatapoint[]
  aiJobs       AiJob[]

  @@index([organizationId, createdAt])
  @@index([organizationId, checksumSha256])
  @@map("document")
}

/// Proof supporting one or more datapoints. Typed; versioned (supersedesId);
/// moves through a lifecycle state machine (see @trace/domain).
model Evidence {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  type             EvidenceType
  title            String
  documentId       String?        @map("document_id") @db.Uuid
  source           String         @default("manual")
  sourceUrl        String?        @map("source_url")
  reportingPeriod  String?        @map("reporting_period")
  issuer           String?
  confidenceScore  Decimal?       @map("confidence_score") @db.Decimal(5, 2)
  hash             String
  metadata         Json           @default("{}")
  status           EvidenceStatus @default(uploaded)
  version          Int            @default(1)
  supersedesId     String?        @map("supersedes_id") @db.Uuid
  uploadedByUserId String         @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt        DateTime?      @map("expires_at") @db.Date

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)
  supersedes       Evidence?              @relation("EvidenceVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     Evidence[]             @relation("EvidenceVersion")
  datapoints       DatapointEvidence[]
  activityLinks    ActivityEvidence[]
  verifications    EvidenceVerification[]
  fromSupplierRefs SupplierEvidenceRef[]  @relation("EvidenceFromSupplierRef")

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("evidence")
}

/// A material sustainability value. `label` tracks the trust lifecycle
/// (ai_extracted → human_reviewed → verified); `provenance` is never downgraded
/// silently (Principle 3). Links to Evidence via DatapointEvidence.
model Datapoint {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  metricKey       String     @map("metric_key")
  valueNumeric    Decimal?   @map("value_numeric") @db.Decimal(20, 6)
  valueText       String?    @map("value_text")
  unit            String?
  provenance      Provenance
  label           DataLabel  @default(human_reviewed)
  reportingPeriod String?    @map("reporting_period")
  subjectType     String     @map("subject_type")
  subjectId       String     @map("subject_id") @db.Uuid
  calculationId   String?    @map("calculation_id") @db.Uuid
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calculation  Calculation?         @relation(fields: [calculationId], references: [id], onDelete: SetNull)
  evidence     DatapointEvidence[]
  promotedFrom CandidateDatapoint[]
  trustScores  TrustScore[]
  qualityIssues DataQualityIssue[]
  anomalies    Anomaly[]

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, metricKey])
  @@map("datapoint")
}

// ---------------------------------------------------------------------------
// Phase 4 — Carbon Engine
// ---------------------------------------------------------------------------

enum GhgScope {
  scope_1
  scope_2_location
  scope_2_market
  scope_3

  @@map("ghg_scope")
}

enum GhgCategory {
  cat_1_purchased_goods_services
  cat_2_capital_goods
  cat_3_fuel_energy_activities
  cat_4_upstream_transportation
  cat_5_waste_generated
  cat_6_business_travel
  cat_7_employee_commuting
  cat_8_upstream_leased_assets
  cat_9_downstream_transportation
  cat_10_processing_sold_products
  cat_11_use_sold_products
  cat_12_end_of_life_sold_products
  cat_13_downstream_leased_assets
  cat_14_franchises
  cat_15_investments

  @@map("ghg_category")
}

enum Methodology {
  supplier_specific
  average_data
  spend_based
  distance_based
  fuel_based
  energy_based
  hybrid

  @@map("methodology")
}

enum Co2eUnit {
  gCO2e
  kgCO2e
  tCO2e
  ktCO2e

  @@map("co2e_unit")
}

/// A versioned emission factor. `organizationId` null => shared library.
/// Calculations pin a specific row (never mutated).
model EmissionFactor {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String?      @map("organization_id") @db.Uuid
  source            String
  sourceRef         String       @map("source_ref")
  name              String
  value             Decimal      @db.Decimal(30, 12)
  numeratorUnit     Co2eUnit     @map("numerator_unit")
  denominatorUnit   String       @map("denominator_unit")
  activityDimension String       @map("activity_dimension")
  gwpSet            String       @default("AR6") @map("gwp_set")
  scope             GhgScope
  ghgCategory       GhgCategory? @map("ghg_category")
  geography         String?
  methodology       Methodology?
  validFrom         DateTime     @map("valid_from") @db.Date
  validTo           DateTime?    @map("valid_to") @db.Date
  version           Int          @default(1)
  isCurrent         Boolean      @default(true) @map("is_current")
  notes             String?
  createdByUserId   String?      @map("created_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calculations Calculation[]

  @@index([source, sourceRef])
  @@index([organizationId, scope])
  @@index([scope, ghgCategory])
  @@map("emission_factor")
}

model ActivityData {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  scope           GhgScope
  ghgCategory     GhgCategory? @map("ghg_category")
  category        String
  description     String?
  value           Decimal      @db.Decimal(20, 6)
  unit            String
  reportingPeriod String       @map("reporting_period")
  provenance      Provenance   @default(supplier_reported)
  subjectType     String       @map("subject_type")
  subjectId       String       @map("subject_id") @db.Uuid
  supplierId      String?      @map("supplier_id") @db.Uuid
  sourceRef       String?      @map("source_ref")
  occurredOn      DateTime?    @map("occurred_on") @db.Date
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calculations Calculation[]
  evidence     ActivityEvidence[]

  @@index([organizationId, reportingPeriod])
  @@index([organizationId, scope])
  @@index([organizationId, subjectType, subjectId])
  @@map("activity_data")
}

model ActivityEvidence {
  organizationId String   @map("organization_id") @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  evidenceId     String   @map("evidence_id") @db.Uuid
  linkedByUserId String   @map("linked_by_user_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  activity ActivityData @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidence Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([activityId, evidenceId])
  @@index([organizationId])
  @@index([evidenceId])
  @@map("activity_evidence")
}

/// Immutable. Stores every input by value and by reference so the result is
/// reproducible from the row alone (Principle 8). Recompute => new row + supersedesId.
model Calculation {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  activityId             String       @map("activity_id") @db.Uuid
  emissionFactorId       String       @map("emission_factor_id") @db.Uuid
  methodology            Methodology
  inputValue             Decimal      @map("input_value") @db.Decimal(20, 6)
  inputUnit              String       @map("input_unit")
  normalizedValue        Decimal      @map("normalized_value") @db.Decimal(30, 12)
  normalizedUnit         String       @map("normalized_unit")
  factorValue            Decimal      @map("factor_value") @db.Decimal(30, 12)
  factorNumeratorUnit    Co2eUnit     @map("factor_numerator_unit")
  factorDenominatorUnit  String       @map("factor_denominator_unit")
  factorSource           String       @map("factor_source")
  factorVersion          Int          @map("factor_version")
  gwpSet                 String       @map("gwp_set")
  scope                  GhgScope
  ghgCategory            GhgCategory? @map("ghg_category")
  reportingPeriod        String       @map("reporting_period")
  resultValueTco2e       Decimal      @map("result_value_tco2e") @db.Decimal(20, 6)
  assumptions            Json         @default("{}")
  steps                  Json         @default("[]")
  factorSelectionReasons Json         @default("[]") @map("factor_selection_reasons")
  calculationVersion     String       @map("calculation_version")
  supersedesId           String?      @map("supersedes_id") @db.Uuid
  calculatedByUserId     String       @map("calculated_by_user_id") @db.Uuid
  calculatedAt           DateTime     @default(now()) @map("calculated_at") @db.Timestamptz(6)
  approvedByUserId       String?      @map("approved_by_user_id") @db.Uuid
  approvedAt             DateTime?    @map("approved_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity       ActivityData   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  emissionFactor EmissionFactor @relation(fields: [emissionFactorId], references: [id])
  supersedes     Calculation?   @relation("CalculationVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   Calculation[]  @relation("CalculationVersion")
  datapoints     Datapoint[]

  @@index([organizationId, scope, reportingPeriod])
  @@index([organizationId, activityId])
  @@map("calculation")
}

/// Rolled-up GHG-inventory total per (scope, category, period). A projection —
/// upserted from calculations by recomputeEmissions.
model Emission {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  scope                GhgScope
  ghgCategory          GhgCategory? @map("ghg_category")
  reportingPeriod      String       @map("reporting_period")
  valueTco2e           Decimal      @map("value_tco2e") @db.Decimal(20, 6)
  calculationCount     Int          @map("calculation_count")
  methodSummary        String       @map("method_summary")
  sourceCalculationIds String[]     @map("source_calculation_ids") @db.Uuid
  computedAt           DateTime     @default(now()) @map("computed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, ghgCategory, reportingPeriod])
  @@index([organizationId, reportingPeriod])
  @@map("emission")
}

model DatapointEvidence {
  organizationId String   @map("organization_id") @db.Uuid
  datapointId    String   @map("datapoint_id") @db.Uuid
  evidenceId     String   @map("evidence_id") @db.Uuid
  linkedByUserId String   @map("linked_by_user_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  datapoint Datapoint @relation(fields: [datapointId], references: [id], onDelete: Cascade)
  evidence  Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([datapointId, evidenceId])
  @@index([organizationId])
  @@index([evidenceId])
  @@map("datapoint_evidence")
}

model EvidenceVerification {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  evidenceId       String   @map("evidence_id") @db.Uuid
  method           String
  outcome          String
  verifiedByUserId String   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)
  notes            String?

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([organizationId, evidenceId])
  @@map("evidence_verification")
}

/// Versioned, append-only aggregated snapshot of a supplier's sustainability
/// profile (brief Module C). `data` is the PassportData from @trace/domain.
model SupplierPassport {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  version          Int
  builderVersion   String   @map("builder_version")
  completeness     Int
  data             Json
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  computedByUserId String?  @map("computed_by_user_id") @db.Uuid

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, version])
  @@index([organizationId, supplierId])
  @@map("supplier_passport")
}

// ---------------------------------------------------------------------------
// Phase 5 — AI Document Intelligence
// ---------------------------------------------------------------------------

enum AiJobStatus {
  queued
  running
  completed
  failed

  @@map("ai_job_status")
}

enum ExtractionStatus {
  pending
  parsing
  parsed
  classifying
  extracting
  ready_for_review
  failed

  @@map("extraction_status")
}

enum CandidateStatus {
  pending
  promoted
  rejected

  @@map("candidate_status")
}

/// One recorded AI (or dev-stub) call. Written before the output is used (ADR-005).
model AiJob {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  capability     String
  provider       String
  model          String
  promptVersion  String      @map("prompt_version")
  inputType      String      @map("input_type")
  inputRef       String      @map("input_ref")
  documentId     String?     @map("document_id") @db.Uuid
  status         AiJobStatus @default(running)
  output         Json?
  confidence     Decimal?    @db.Decimal(5, 2)
  tokensIn       Int         @default(0) @map("tokens_in")
  tokensOut      Int         @default(0) @map("tokens_out")
  costEur        Decimal     @default(0) @map("cost_eur") @db.Decimal(12, 6)
  latencyMs      Int         @default(0) @map("latency_ms")
  reviewerId     String?     @map("reviewer_id") @db.Uuid
  error          String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, capability])
  @@map("ai_job")
}

/// The parsed artifact + pipeline state for one document.
model DocumentExtraction {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  documentId     String           @unique @map("document_id") @db.Uuid
  status         ExtractionStatus @default(pending)
  parser         String?
  parsedText     String?          @map("parsed_text")
  pageCount      Int?             @map("page_count")
  truncated      Boolean          @default(false)
  classification Json?
  aiJobIds       String[]         @map("ai_job_ids") @db.Uuid
  candidateCount Int              @default(0) @map("candidate_count")
  error          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("document_extraction")
}

/// An AI-proposed datapoint awaiting human review. Never used in trusted
/// reporting; a reviewer with `candidate.review` promotes it to a Datapoint
/// (or rejects it). ADR-005.
model CandidateDatapoint {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  documentId          String          @map("document_id") @db.Uuid
  extractionId        String?         @map("extraction_id") @db.Uuid
  aiJobId             String?         @map("ai_job_id") @db.Uuid
  metricKey           String          @map("metric_key")
  label               String
  valueNumeric        Decimal?        @map("value_numeric") @db.Decimal(20, 6)
  valueText           String?         @map("value_text")
  unit                String?
  reportingPeriod     String?         @map("reporting_period")
  provenanceGuess     Provenance      @default(supplier_reported) @map("provenance_guess")
  confidence          Decimal         @db.Decimal(5, 2)
  sourceSpans         Json            @default("[]") @map("source_spans")
  rationale           String?
  status              CandidateStatus @default(pending)
  promotedDatapointId String?         @map("promoted_datapoint_id") @db.Uuid
  reviewedByUserId    String?         @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  reviewNote          String?         @map("review_note")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  document          Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  promotedDatapoint Datapoint? @relation(fields: [promotedDatapointId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, documentId])
  @@map("candidate_datapoint")
}

// ---------------------------------------------------------------------------
// Phase 6 — Trust Engine
// ---------------------------------------------------------------------------

enum TrustBand {
  high
  medium
  low

  @@map("trust_band")
}

enum DataQualityIssueKind {
  missing_value
  missing_unit
  missing_evidence
  unverified_evidence
  expired_evidence
  stale_data
  unit_inconsistency
  impossible_value
  duplicate
  conflicting_supplier_report
  outdated_factor
  low_methodology_tier

  @@map("data_quality_issue_kind")
}

enum IssueSeverity {
  critical
  warning
  info

  @@map("issue_severity")
}

enum IssueStatus {
  open
  acknowledged
  resolved
  dismissed

  @@map("issue_status")
}

enum AnomalyMethod {
  mad_outlier
  relative_change

  @@map("anomaly_method")
}

enum AnomalyStatus {
  open
  explained
  dismissed

  @@map("anomaly_status")
}

/// Immutable, versioned Trust Score for one datapoint (brief §9,
/// docs/domain-model.md#trace-trust-score-model). The additive breakdown is
/// stored so the score always renders its own explanation. Recompute chains a
/// new row via `supersedesId`; the current score is the one with no successor.
model TrustScore {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  datapointId    String    @map("datapoint_id") @db.Uuid
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id") @db.Uuid
  metricKey      String    @map("metric_key")
  reportingPeriod String?  @map("reporting_period")
  value          Int
  band           TrustBand
  breakdown      Json      @default("[]")
  modelVersion   String    @map("model_version")
  inputsDigest   String    @map("inputs_digest")
  supersedesId   String?   @map("supersedes_id") @db.Uuid
  computedByUserId String? @map("computed_by_user_id") @db.Uuid
  computedAt     DateTime  @default(now()) @map("computed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datapoint    Datapoint    @relation(fields: [datapointId], references: [id], onDelete: Cascade)
  supersedes   TrustScore?  @relation("TrustScoreVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy TrustScore[] @relation("TrustScoreVersion")

  @@index([organizationId, datapointId, computedAt])
  @@index([organizationId, band])
  @@map("trust_score")
}

/// A detected data-quality problem (brief §9). `dedupeKey` makes a re-scan
/// idempotent: an existing open issue is refreshed (`lastSeenAt`), and an issue
/// no longer detected is auto-resolved. Never hard-deleted — a dismissed issue
/// records the human judgement that it was not a real problem.
model DataQualityIssue {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  kind            DataQualityIssueKind
  severity        IssueSeverity
  status          IssueStatus         @default(open)
  subjectType     String              @map("subject_type")
  subjectId       String              @map("subject_id") @db.Uuid
  datapointId     String?             @map("datapoint_id") @db.Uuid
  metricKey       String?             @map("metric_key")
  reportingPeriod String?             @map("reporting_period")
  dedupeKey       String              @map("dedupe_key")
  title           String
  detail          String
  facts           Json                @default("{}")
  rulesVersion    String              @map("rules_version")
  firstDetectedAt DateTime            @default(now()) @map("first_detected_at") @db.Timestamptz(6)
  lastSeenAt      DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt      DateTime?           @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId String?            @map("resolved_by_user_id") @db.Uuid
  resolutionNote  String?             @map("resolution_note")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datapoint    Datapoint?   @relation(fields: [datapointId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, severity])
  @@index([organizationId, kind])
  @@map("data_quality_issue")
}

/// A flagged statistical deviation with candidate explanations (brief §9).
/// Deterministic detectors only (see @trace/domain); a human confirms or
/// dismisses. `dedupeKey` keeps re-scans idempotent.
model Anomaly {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  method          AnomalyMethod
  status          AnomalyStatus @default(open)
  subjectType     String        @map("subject_type")
  subjectId       String        @map("subject_id") @db.Uuid
  datapointId     String?       @map("datapoint_id") @db.Uuid
  metricKey       String        @map("metric_key")
  pointKey        String        @map("point_key")
  reportingPeriod String?       @map("reporting_period")
  dedupeKey       String        @map("dedupe_key")
  observedValue   Decimal       @map("observed_value") @db.Decimal(30, 6)
  expectedValue   Decimal       @map("expected_value") @db.Decimal(30, 6)
  score           Decimal       @db.Decimal(12, 4)
  direction       String
  explanations    Json          @default("[]")
  detectorVersion String        @map("detector_version")
  detectedAt      DateTime      @default(now()) @map("detected_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  reviewedByUserId String?      @map("reviewed_by_user_id") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote      String?       @map("review_note")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datapoint    Datapoint?   @relation(fields: [datapointId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status])
  @@index([organizationId, metricKey])
  @@map("anomaly")
}

/// One run of the trust + data-quality scan. Gives the Data Quality surface a
/// header and a history, and records the model / rules versions used.
model QualityScan {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  reportingPeriod  String?   @map("reporting_period")
  datapointsScored Int       @default(0) @map("datapoints_scored")
  avgTrustScore    Decimal?  @map("avg_trust_score") @db.Decimal(6, 2)
  issuesOpened     Int       @default(0) @map("issues_opened")
  issuesResolved   Int       @default(0) @map("issues_resolved")
  issuesOpen       Int       @default(0) @map("issues_open")
  anomaliesFound   Int       @default(0) @map("anomalies_found")
  modelVersion     String    @map("model_version")
  rulesVersion     String    @map("rules_version")
  detectorVersion  String    @map("detector_version")
  ranByUserId      String?   @map("ran_by_user_id") @db.Uuid
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs       Int       @default(0) @map("duration_ms")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@map("quality_scan")
}

// ---------------------------------------------------------------------------
// Phase 7 — Compliance
// ---------------------------------------------------------------------------

enum ComplianceStatus {
  not_started
  data_available
  evidence_available
  mapping_complete
  review_required

  @@map("compliance_status")
}

enum ControlStatus {
  not_implemented
  implemented
  needs_testing
  passed
  failed

  @@map("control_status")
}

/// A regulation in the versioned rule store (Principle 7). Global rows
/// (no organization); repository-scoped, never RLS'd. Superseding a
/// `ruleStoreVersion` inserts new rows and leaves prior ones untouched.
model Regulation {
  key              String
  name             String
  jurisdiction     String
  description      String   @default("")
  ruleStoreVersion String   @map("rule_store_version")
  notice           String   @default("")
  loadedAt         DateTime @default(now()) @map("loaded_at") @db.Timestamptz(6)

  id           String        @id @default(uuid()) @db.Uuid
  requirements Requirement[]

  @@unique([key, ruleStoreVersion])
  @@map("regulation")
}

model Requirement {
  id               String @id @default(uuid()) @db.Uuid
  regulationId     String @map("regulation_id") @db.Uuid
  code             String
  title            String
  description      String @default("")
  ruleStoreVersion String @map("rule_store_version")

  regulation  Regulation          @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  disclosures Disclosure[]
  controls    ComplianceControl[]

  @@unique([regulationId, code])
  @@map("requirement")
}

model Disclosure {
  id               String @id @default(uuid()) @db.Uuid
  requirementId    String @map("requirement_id") @db.Uuid
  code             String
  title            String
  guidance         String @default("")
  ruleStoreVersion String @map("rule_store_version")

  requirement          Requirement             @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  requiredDatapoints   RequiredDatapoint[]
  evidenceRequirements EvidenceRequirement[]
  mappings             ComplianceMapping[]
  statuses             DisclosureStatusRecord[]

  @@unique([requirementId, code, ruleStoreVersion])
  @@map("disclosure")
}

model RequiredDatapoint {
  id               String  @id @default(uuid()) @db.Uuid
  disclosureId     String  @map("disclosure_id") @db.Uuid
  key              String
  metricKey        String  @map("metric_key")
  unit             String?
  cardinality      String  @default("single")
  subjectScope     String  @default("organization") @map("subject_scope")
  aggregation      String  @default("single")
  minTrustScore    Int?    @map("min_trust_score")
  label            String  @default("")
  conditions       Json    @default("{}")
  ruleStoreVersion String  @map("rule_store_version")

  disclosure Disclosure          @relation(fields: [disclosureId], references: [id], onDelete: Cascade)
  mappings   ComplianceMapping[]

  @@unique([key, ruleStoreVersion])
  @@index([metricKey])
  @@map("required_datapoint")
}

model EvidenceRequirement {
  id               String   @id @default(uuid()) @db.Uuid
  disclosureId     String   @map("disclosure_id") @db.Uuid
  key              String
  description      String
  acceptableTypes  String[] @map("acceptable_types")
  ruleStoreVersion String   @map("rule_store_version")

  disclosure Disclosure @relation(fields: [disclosureId], references: [id], onDelete: Cascade)

  @@unique([disclosureId, key, ruleStoreVersion])
  @@map("evidence_requirement")
}

/// An organization-level control expected for a requirement. Tenant-owned (RLS).
model ComplianceControl {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  requirementId    String?       @map("requirement_id") @db.Uuid
  ruleStoreVersion String        @map("rule_store_version")
  key              String
  name             String
  description      String        @default("")
  owner            String?
  status           ControlStatus @default(not_implemented)
  lastTestedAt     DateTime?     @map("last_tested_at") @db.Timestamptz(6)
  note             String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement  Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("compliance_control")
}

/// The engine's suggested (and optionally human-confirmed) link between a
/// required datapoint and the tenant's company data. Objective `status`;
/// `gapReasons` explains why it is not `mapping_complete`. Tenant-owned (RLS).
model ComplianceMapping {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  requiredDatapointId String          @map("required_datapoint_id") @db.Uuid
  disclosureId       String           @map("disclosure_id") @db.Uuid
  ruleStoreVersion   String           @map("rule_store_version")
  reportingPeriod    String?          @map("reporting_period")
  status             ComplianceStatus @default(not_started)
  gapReasons         String[]         @map("gap_reasons")
  datapointIds       String[]         @map("datapoint_ids") @db.Uuid
  calculationIds     String[]         @map("calculation_ids") @db.Uuid
  evidenceIds        String[]         @map("evidence_ids") @db.Uuid
  resolvedValue      Decimal?         @map("resolved_value") @db.Decimal(30, 6)
  resolvedValueText  String?          @map("resolved_value_text")
  trustScore         Int?             @map("trust_score")
  confirmed          Boolean          @default(false)
  confirmedByUserId  String?          @map("confirmed_by_user_id") @db.Uuid
  confirmedAt        DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  note               String?
  computedAt         DateTime         @default(now()) @map("computed_at") @db.Timestamptz(6)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requiredDatapoint RequiredDatapoint @relation(fields: [requiredDatapointId], references: [id], onDelete: Cascade)
  disclosure        Disclosure        @relation(fields: [disclosureId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requiredDatapointId, ruleStoreVersion])
  @@index([organizationId, status])
  @@index([organizationId, disclosureId])
  @@map("compliance_mapping")
}

/// Rolled-up objective status of a disclosure for one tenant + rule-store
/// version. Tenant-owned (RLS).
model DisclosureStatusRecord {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  disclosureId     String           @map("disclosure_id") @db.Uuid
  ruleStoreVersion String           @map("rule_store_version")
  reportingPeriod  String?          @map("reporting_period")
  status           ComplianceStatus @default(not_started)
  requiredTotal    Int              @default(0) @map("required_total")
  satisfied        Int              @default(0)
  readinessPct     Decimal          @default(0) @map("readiness_pct") @db.Decimal(5, 1)
  computedAt       DateTime         @default(now()) @map("computed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  disclosure  Disclosure   @relation(fields: [disclosureId], references: [id], onDelete: Cascade)

  @@unique([organizationId, disclosureId, ruleStoreVersion])
  @@index([organizationId, status])
  @@map("disclosure_status")
}

/// One run of the compliance mapping engine. Tenant-owned (RLS).
model ComplianceRun {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  ruleStoreVersion     String    @map("rule_store_version")
  reportingPeriod      String?   @map("reporting_period")
  disclosuresEvaluated Int       @default(0) @map("disclosures_evaluated")
  requiredDatapoints   Int       @default(0) @map("required_datapoints")
  mappingsWritten      Int       @default(0) @map("mappings_written")
  readinessPct         Decimal   @default(0) @map("readiness_pct") @db.Decimal(5, 1)
  ranByUserId          String?   @map("ran_by_user_id") @db.Uuid
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs           Int       @default(0) @map("duration_ms")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@map("compliance_run")
}

// ---------------------------------------------------------------------------
// Phase 8 — Audit workspace
// ---------------------------------------------------------------------------

enum AuditStatus {
  planning
  fieldwork
  review
  complete

  @@map("audit_status")
}

enum FindingSeverity {
  critical
  warning
  info

  @@map("finding_severity")
}

enum FindingSource {
  manual
  simulation

  @@map("finding_source")
}

enum FindingStatus {
  open
  acknowledged
  remediating
  resolved
  accepted_risk
  dismissed

  @@map("finding_status")
}

enum AuditPackageStatus {
  generating
  ready
  failed

  @@map("audit_package_status")
}

/// An audit engagement: a scope + period a person or an external auditor is
/// assessing. Findings and packages may be attached to one.
model Audit {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  name               String
  scope              String      @default("")
  reportingPeriod    String?     @map("reporting_period")
  periodStart        DateTime?   @map("period_start") @db.Date
  periodEnd          DateTime?   @map("period_end") @db.Date
  status             AuditStatus @default(planning)
  leadAuditorUserId  String?     @map("lead_auditor_user_id") @db.Uuid
  externalAuditor    String?     @map("external_auditor")
  ruleStoreVersion   String?     @map("rule_store_version")
  notes              String?
  createdByUserId    String      @map("created_by_user_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt           DateTime?   @map("closed_at") @db.Timestamptz(6)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings       AuditFinding[]
  simulationRuns AuditSimulationRun[]
  packages       AuditPackage[]

  @@index([organizationId, status])
  @@map("audit")
}

/// An issue against audit readiness. `source = simulation` rows are idempotent
/// on `dedupeKey`: a re-run refreshes an open one and auto-resolves ones no
/// longer detected; `accepted_risk` / `dismissed` are sticky. `source = manual`
/// rows are raised by a person and never auto-resolved.
model AuditFinding {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  auditId            String?         @map("audit_id") @db.Uuid
  simulationRunId    String?         @map("simulation_run_id") @db.Uuid
  source             FindingSource   @default(manual)
  severity           FindingSeverity
  kind               String?
  status             FindingStatus   @default(open)
  subjectType        String          @map("subject_type")
  subjectId          String          @map("subject_id")
  dedupeKey          String          @map("dedupe_key")
  title              String
  detail             String
  recommendation     String?
  raisedByUserId     String?         @map("raised_by_user_id") @db.Uuid
  assignedToUserId   String?         @map("assigned_to_user_id") @db.Uuid
  dueOn              DateTime?       @map("due_on") @db.Date
  firstDetectedAt    DateTime        @default(now()) @map("first_detected_at") @db.Timestamptz(6)
  lastSeenAt         DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedByUserId   String?         @map("resolved_by_user_id") @db.Uuid
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolutionNote     String?         @map("resolution_note")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit         Audit?             @relation(fields: [auditId], references: [id], onDelete: SetNull)
  simulationRun AuditSimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, severity])
  @@index([organizationId, auditId])
  @@map("audit_finding")
}

/// One run of the audit-readiness simulation. Stores the additive breakdown and
/// itemised issue counts; each run writes / refreshes `audit_finding` rows.
model AuditSimulationRun {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  auditId          String?  @map("audit_id") @db.Uuid
  reportingPeriod  String?  @map("reporting_period")
  ruleStoreVersion String?  @map("rule_store_version")
  readinessValue   Int      @map("readiness_value")
  readinessBand    String   @map("readiness_band")
  breakdown        Json     @default("[]")
  issueCounts      Json     @default("{}") @map("issue_counts")
  findingsOpened   Int      @default(0) @map("findings_opened")
  findingsResolved Int      @default(0) @map("findings_resolved")
  findingsOpen     Int      @default(0) @map("findings_open")
  modelVersion     String   @map("model_version")
  ranByUserId      String?  @map("ran_by_user_id") @db.Uuid
  startedAt        DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs       Int      @default(0) @map("duration_ms")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit?         @relation(fields: [auditId], references: [id], onDelete: SetNull)
  findings     AuditFinding[]

  @@index([organizationId, startedAt])
  @@map("audit_simulation_run")
}

/// An exportable, content-addressed bundle: organization profile, readiness
/// snapshot, evidence + verifications, calculations + steps + reproducibility,
/// datapoints + lineage + Trust, compliance overview + mappings + gaps, open
/// findings, and the audit-log chain verification. Written to object storage as
/// canonical JSON.
model AuditPackage {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  auditId          String?            @map("audit_id") @db.Uuid
  reportingPeriod  String?            @map("reporting_period")
  ruleStoreVersion String?            @map("rule_store_version")
  status           AuditPackageStatus @default(generating)
  format           String             @default("json")
  storageKey       String?            @map("storage_key")
  storageDriver    String?            @map("storage_driver")
  sizeBytes        Int?               @map("size_bytes")
  checksumSha256   String?            @map("checksum_sha256")
  contentDigest    String             @default("") @map("content_digest")
  manifest         Json               @default("{}")
  readinessValue   Int?               @map("readiness_value")
  generatedByUserId String?           @map("generated_by_user_id") @db.Uuid
  generatedAt      DateTime?          @map("generated_at") @db.Timestamptz(6)
  error            String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit?       @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_package")
}

// ---------------------------------------------------------------------------
// Phase 10 — Ask TRACE
// ---------------------------------------------------------------------------

/// One natural-language question and its retrieval-grounded answer. `intent` is
/// a fixed catalog value chosen by the model; `citations` are the retrieved
/// records the answer relied on (each with a UI href). `answered = false` when
/// retrieval returned nothing or the model judged the records insufficient.
model AskQuery {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  question        String
  intent          String
  reportingPeriod String?  @map("reporting_period")
  answered        Boolean  @default(false)
  answer          String   @default("")
  recordCount     Int      @default(0) @map("record_count")
  citations       Json     @default("[]")
  aiJobIds        String[] @map("ai_job_ids") @db.Uuid
  provider        String?
  model           String?
  tokensIn        Int      @default(0) @map("tokens_in")
  tokensOut       Int      @default(0) @map("tokens_out")
  costEur         Decimal  @default(0) @map("cost_eur") @db.Decimal(12, 6)
  latencyMs       Int      @default(0) @map("latency_ms")
  askedByUserId   String?  @map("asked_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ask_query")
}

// ---------------------------------------------------------------------------
// Phase 11 — Procurement intelligence
// ---------------------------------------------------------------------------

/// A saved procurement carbon what-if. `inputs` holds the supplier lines +
/// proposed changes; `result` holds the deterministic `projectScenario` output.
/// Immutable once created — re-modelling produces a new row.
model ProcurementScenario {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  description     String?
  reportingPeriod String?  @map("reporting_period")
  engineVersion   String   @map("engine_version")
  baselineTco2e   Decimal  @map("baseline_tco2e") @db.Decimal(20, 4)
  projectedTco2e  Decimal  @map("projected_tco2e") @db.Decimal(20, 4)
  deltaTco2e      Decimal  @map("delta_tco2e") @db.Decimal(20, 4)
  deltaPct        Decimal  @map("delta_pct") @db.Decimal(8, 2)
  inputs          Json     @default("{}")
  result          Json     @default("{}")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("procurement_scenario")
}

// ---------------------------------------------------------------------------
// Phase 12 — Enterprise integrations
// ---------------------------------------------------------------------------

enum IntegrationStatus {
  active
  paused
  error

  @@map("integration_status")
}

enum IntegrationRunStatus {
  running
  completed
  failed

  @@map("integration_run_status")
}

/// A saved connector configuration. `config` holds the reusable column mapping +
/// import defaults for its `kind` (only `csv_activity` in Phase 12; the
/// `IntegrationAdapter` contract in @trace/domain is what a REST/SFTP/ERP
/// connector would implement next).
model Integration {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  kind            String
  name            String
  config          Json              @default("{}")
  status          IntegrationStatus @default(active)
  lastRunAt       DateTime?         @map("last_run_at") @db.Timestamptz(6)
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         IntegrationRun[]

  @@index([organizationId, kind])
  @@map("integration")
}

/// One import execution. Records the mapping + defaults used, per-row validation
/// counts, a capped preview sample, any per-row errors, and the `activity_data`
/// rows it created (each stamped `source_ref = import:<run>:<line>`).
model IntegrationRun {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  integrationId      String?              @map("integration_id") @db.Uuid
  kind               String
  status             IntegrationRunStatus @default(running)
  fileName           String?              @map("file_name")
  fileChecksum       String?              @map("file_checksum")
  mapping            Json                 @default("{}")
  defaults           Json                 @default("{}")
  rowsTotal          Int                  @default(0) @map("rows_total")
  rowsValid          Int                  @default(0) @map("rows_valid")
  rowsInvalid        Int                  @default(0) @map("rows_invalid")
  rowsImported       Int                  @default(0) @map("rows_imported")
  preview            Json                 @default("[]")
  errors             Json                 @default("[]")
  createdActivityIds String[]             @map("created_activity_ids") @db.Uuid
  ranByUserId        String?              @map("ran_by_user_id") @db.Uuid
  startedAt          DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(6)
  durationMs         Int                  @default(0) @map("duration_ms")
  error              String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@map("integration_run")
}
