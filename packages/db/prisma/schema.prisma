// TRACE database schema.
//
// Phase 1 scope: identity, tenancy, RBAC, sessions, magic-link auth, invitations,
// and the tamper-evident audit log. Later phases add supply chain, carbon,
// evidence, trust, compliance, and audit workspace models.
//
// Conventions (docs/data-model.md):
//   - uuid primary keys, column `id`
//   - every tenant-owned row carries `organizationId`
//   - snake_case table/column names via @@map / @map
//   - append-only audit_log; RLS on unambiguously tenant-owned tables (0001_rls)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum MagicLinkPurpose {
  login
  invite

  @@map("magic_link_purpose")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum SupplierStatus {
  active
  archived

  @@map("supplier_status")
}

enum SupplierRequestKind {
  sustainability_questionnaire

  @@map("supplier_request_kind")
}

enum SupplierRequestStatus {
  draft
  sent
  in_progress
  submitted
  accepted
  declined

  @@map("supplier_request_status")
}

enum EvidenceType {
  supplier_report
  invoice
  utility_bill
  certificate
  epd
  lca
  audit_report
  questionnaire
  erp_record
  logistics_record
  contract
  external_dataset

  @@map("evidence_type")
}

model Organization {
  id                    String             @id @default(uuid()) @db.Uuid
  slug                  String             @unique
  legalName             String             @map("legal_name")
  country               String             @db.Char(2)
  baseCurrency          String             @default("EUR") @map("base_currency") @db.Char(3)
  reportingPeriodConfig Json               @default("{}") @map("reporting_period_config")
  status                OrganizationStatus @default(active)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  businessUnits   BusinessUnit[]
  memberships     Membership[]
  roles           Role[]
  invitations     Invitation[]
  sessions        Session[]
  suppliers       Supplier[]
  documents       Document[]
  evidence        Evidence[]
  datapoints      Datapoint[]
  emissionFactors EmissionFactor[]
  activityData    ActivityData[]
  calculations    Calculation[]
  emissions       Emission[]

  @@map("organization")
}

model BusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       BusinessUnit?  @relation("BusinessUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     BusinessUnit[] @relation("BusinessUnitTree")

  @@index([organizationId, name])
  @@map("business_unit")
}

/// Platform-level identity. A person; may hold memberships in several organizations.
model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String
  status     String   @default("active")
  mfaEnabled Boolean  @default(false) @map("mfa_enabled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     Membership[]
  sessions        Session[]
  sentInvitations Invitation[] @relation("InvitationInvitedBy")

  @@map("user")
}

/// User <-> Organization link. The tenant-scoped identity.
/// `supplierId` set => a supplier-portal user scoped to that one supplier.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  supplierId     String?          @map("supplier_id") @db.Uuid
  status         MembershipStatus @default(invited)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([supplierId])
  @@map("membership")
}

/// Named bundle of permissions. `organizationId` null => platform role.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String   @default("")
  isPlatform     Boolean  @default(false) @map("is_platform")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, key])
  @@map("role")
}

/// Global permission catalog. Rows mirror @trace/shared PERMISSIONS.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permission")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role")
}

/// Server-side session for cookie auth. `tokenHash` = sha256 of the opaque cookie value.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  mfaPassed      Boolean   @default(false) @map("mfa_passed")
  ip             String?
  userAgentHash  String?   @map("user_agent_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// One-time email token for passwordless login and invitation acceptance.
model MagicLinkToken {
  id           String           @id @default(uuid()) @db.Uuid
  email        String
  tokenHash    String           @unique @map("token_hash")
  purpose      MagicLinkPurpose
  invitationId String?          @map("invitation_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?        @map("consumed_at") @db.Timestamptz(6)

  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@map("magic_link_token")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  roleKeys        String[]         @map("role_keys")
  supplierId      String?          @map("supplier_id") @db.Uuid
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  status          InvitationStatus @default(pending)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tokens       MagicLinkToken[]

  @@index([organizationId, status])
  @@index([email])
  @@index([supplierId])
  @@map("invitation")
}

/// Append-only, hash-chained activity log (ADR-004). No updates or deletes:
/// enforced by 0002_audit_log_guard (trigger) and revoked privileges in prod.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  before         Json?
  after          Json?
  requestId      String   @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  prevHash       String   @map("prev_hash")
  hash           String   @map("hash")

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

/// One row per audit scope (organization id as text, or "platform"). Locked
/// `FOR UPDATE` during an append so the hash chain is serialized per scope.
model AuditHead {
  scope     String   @id
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("audit_head")
}

// ---------------------------------------------------------------------------
// Phase 2 — Supplier Intelligence
// ---------------------------------------------------------------------------

model Supplier {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String
  country         String         @db.Char(2)
  industryNace    String?        @map("industry_nace")
  registrationIds Json           @default("{}") @map("registration_ids")
  status          SupplierStatus @default(active)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     SupplierContact[]
  locations    SupplierLocation[]
  relationship SupplierRelationship?
  requests     SupplierRequest[]
  evidenceRefs SupplierEvidenceRef[]
  passports    SupplierPassport[]
  memberships  Membership[]
  invitations  Invitation[]

  @@index([organizationId, name])
  @@index([organizationId, status])
  @@map("supplier")
}

model SupplierContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  email          String
  name           String
  role           String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, email])
  @@index([organizationId, supplierId])
  @@map("supplier_contact")
}

model SupplierLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  kind           String   @default("site")
  label          String
  country        String   @db.Char(2)
  address        Json     @default("{}")
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId, supplierId])
  @@map("supplier_location")
}

model SupplierRelationship {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  supplierId     String    @unique @map("supplier_id") @db.Uuid
  category       String?
  tier           Int?
  annualSpend    Decimal?  @map("annual_spend") @db.Decimal(18, 2)
  currency       String    @default("EUR") @db.Char(3)
  since          DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("supplier_relationship")
}

/// An information request sent to a supplier. Phase 2: a fixed sustainability
/// questionnaire. `responses` is keyed by question id (see @trace/domain).
model SupplierRequest {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  supplierId        String                @map("supplier_id") @db.Uuid
  kind              SupplierRequestKind   @default(sustainability_questionnaire)
  templateVersion   String                @map("template_version")
  title             String
  message           String?
  status            SupplierRequestStatus @default(draft)
  dueOn             DateTime?             @map("due_on") @db.Date
  responses         Json                  @default("{}")
  createdByUserId   String                @map("created_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?             @map("sent_at") @db.Timestamptz(6)
  submittedAt       DateTime?             @map("submitted_at") @db.Timestamptz(6)
  submittedByUserId String?               @map("submitted_by_user_id") @db.Uuid
  reviewedAt        DateTime?             @map("reviewed_at") @db.Timestamptz(6)

  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evidenceRefs SupplierEvidenceRef[]

  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@map("supplier_request")
}

/// Lightweight evidence pointer submitted by a supplier. Phase 3 links these to
/// real Document + Evidence records; for now it captures the claim + a URL/note.
model SupplierEvidenceRef {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  supplierId         String       @map("supplier_id") @db.Uuid
  requestId          String?      @map("request_id") @db.Uuid
  documentId         String?      @map("document_id") @db.Uuid
  promotedEvidenceId String?      @map("promoted_evidence_id") @db.Uuid
  type               EvidenceType
  title              String
  sourceUrl          String?      @map("source_url")
  note               String?
  reportingPeriod    String?      @map("reporting_period")
  verified           Boolean      @default(false)
  submittedByUserId  String       @map("submitted_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier         Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  request          SupplierRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  document         Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  promotedEvidence Evidence?        @relation("EvidenceFromSupplierRef", fields: [promotedEvidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, supplierId])
  @@map("supplier_evidence_ref")
}

// ---------------------------------------------------------------------------
// Phase 3 — Evidence Infrastructure
// ---------------------------------------------------------------------------

enum Provenance {
  measured
  supplier_reported
  calculated
  estimated
  modeled
  inferred

  @@map("provenance")
}

enum DataLabel {
  ai_extracted
  human_reviewed
  verified

  @@map("data_label")
}

enum EvidenceStatus {
  uploaded
  processing
  extracted
  reviewed
  verified
  rejected
  expired
  superseded

  @@map("evidence_status")
}

enum DocumentProcessingStatus {
  received
  scanned
  failed

  @@map("document_processing_status")
}

enum ScanStatus {
  pending
  clean
  infected
  skipped

  @@map("scan_status")
}

/// A stored file. Content-addressed by `checksumSha256`; `storageKey` is opaque
/// and never exposed — downloads go through a short-lived signed URL.
model Document {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  filename         String
  mime             String
  sizeBytes        Int                      @map("size_bytes")
  checksumSha256   String                   @map("checksum_sha256")
  storageKey       String                   @map("storage_key")
  storageDriver    String                   @map("storage_driver")
  version          Int                      @default(1)
  processingStatus DocumentProcessingStatus @default(received) @map("processing_status")
  scanStatus       ScanStatus               @default(pending) @map("scan_status")
  retentionUntil   DateTime?                @map("retention_until") @db.Date
  uploadedByUserId String                   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     Evidence[]
  supplierRefs SupplierEvidenceRef[]

  @@index([organizationId, createdAt])
  @@index([organizationId, checksumSha256])
  @@map("document")
}

/// Proof supporting one or more datapoints. Typed; versioned (supersedesId);
/// moves through a lifecycle state machine (see @trace/domain).
model Evidence {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  type             EvidenceType
  title            String
  documentId       String?        @map("document_id") @db.Uuid
  source           String         @default("manual")
  sourceUrl        String?        @map("source_url")
  reportingPeriod  String?        @map("reporting_period")
  issuer           String?
  confidenceScore  Decimal?       @map("confidence_score") @db.Decimal(5, 2)
  hash             String
  metadata         Json           @default("{}")
  status           EvidenceStatus @default(uploaded)
  version          Int            @default(1)
  supersedesId     String?        @map("supersedes_id") @db.Uuid
  uploadedByUserId String         @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt        DateTime?      @map("expires_at") @db.Date

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)
  supersedes       Evidence?              @relation("EvidenceVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     Evidence[]             @relation("EvidenceVersion")
  datapoints       DatapointEvidence[]
  activityLinks    ActivityEvidence[]
  verifications    EvidenceVerification[]
  fromSupplierRefs SupplierEvidenceRef[]  @relation("EvidenceFromSupplierRef")

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("evidence")
}

/// A material sustainability value. `label` tracks the trust lifecycle
/// (ai_extracted → human_reviewed → verified); `provenance` is never downgraded
/// silently (Principle 3). Links to Evidence via DatapointEvidence.
model Datapoint {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  metricKey       String     @map("metric_key")
  valueNumeric    Decimal?   @map("value_numeric") @db.Decimal(20, 6)
  valueText       String?    @map("value_text")
  unit            String?
  provenance      Provenance
  label           DataLabel  @default(human_reviewed)
  reportingPeriod String?    @map("reporting_period")
  subjectType     String     @map("subject_type")
  subjectId       String     @map("subject_id") @db.Uuid
  calculationId   String?    @map("calculation_id") @db.Uuid
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calculation  Calculation?        @relation(fields: [calculationId], references: [id], onDelete: SetNull)
  evidence     DatapointEvidence[]

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, metricKey])
  @@map("datapoint")
}

// ---------------------------------------------------------------------------
// Phase 4 — Carbon Engine
// ---------------------------------------------------------------------------

enum GhgScope {
  scope_1
  scope_2_location
  scope_2_market
  scope_3

  @@map("ghg_scope")
}

enum GhgCategory {
  cat_1_purchased_goods_services
  cat_2_capital_goods
  cat_3_fuel_energy_activities
  cat_4_upstream_transportation
  cat_5_waste_generated
  cat_6_business_travel
  cat_7_employee_commuting
  cat_8_upstream_leased_assets
  cat_9_downstream_transportation
  cat_10_processing_sold_products
  cat_11_use_sold_products
  cat_12_end_of_life_sold_products
  cat_13_downstream_leased_assets
  cat_14_franchises
  cat_15_investments

  @@map("ghg_category")
}

enum Methodology {
  supplier_specific
  average_data
  spend_based
  distance_based
  fuel_based
  energy_based
  hybrid

  @@map("methodology")
}

enum Co2eUnit {
  gCO2e
  kgCO2e
  tCO2e
  ktCO2e

  @@map("co2e_unit")
}

/// A versioned emission factor. `organizationId` null => shared library.
/// Calculations pin a specific row (never mutated).
model EmissionFactor {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String?      @map("organization_id") @db.Uuid
  source            String
  sourceRef         String       @map("source_ref")
  name              String
  value             Decimal      @db.Decimal(30, 12)
  numeratorUnit     Co2eUnit     @map("numerator_unit")
  denominatorUnit   String       @map("denominator_unit")
  activityDimension String       @map("activity_dimension")
  gwpSet            String       @default("AR6") @map("gwp_set")
  scope             GhgScope
  ghgCategory       GhgCategory? @map("ghg_category")
  geography         String?
  methodology       Methodology?
  validFrom         DateTime     @map("valid_from") @db.Date
  validTo           DateTime?    @map("valid_to") @db.Date
  version           Int          @default(1)
  isCurrent         Boolean      @default(true) @map("is_current")
  notes             String?
  createdByUserId   String?      @map("created_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calculations Calculation[]

  @@index([source, sourceRef])
  @@index([organizationId, scope])
  @@index([scope, ghgCategory])
  @@map("emission_factor")
}

model ActivityData {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  scope           GhgScope
  ghgCategory     GhgCategory? @map("ghg_category")
  category        String
  description     String?
  value           Decimal      @db.Decimal(20, 6)
  unit            String
  reportingPeriod String       @map("reporting_period")
  provenance      Provenance   @default(supplier_reported)
  subjectType     String       @map("subject_type")
  subjectId       String       @map("subject_id") @db.Uuid
  supplierId      String?      @map("supplier_id") @db.Uuid
  sourceRef       String?      @map("source_ref")
  occurredOn      DateTime?    @map("occurred_on") @db.Date
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calculations Calculation[]
  evidence     ActivityEvidence[]

  @@index([organizationId, reportingPeriod])
  @@index([organizationId, scope])
  @@index([organizationId, subjectType, subjectId])
  @@map("activity_data")
}

model ActivityEvidence {
  organizationId String   @map("organization_id") @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  evidenceId     String   @map("evidence_id") @db.Uuid
  linkedByUserId String   @map("linked_by_user_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  activity ActivityData @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidence Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([activityId, evidenceId])
  @@index([organizationId])
  @@index([evidenceId])
  @@map("activity_evidence")
}

/// Immutable. Stores every input by value and by reference so the result is
/// reproducible from the row alone (Principle 8). Recompute => new row + supersedesId.
model Calculation {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  activityId             String       @map("activity_id") @db.Uuid
  emissionFactorId       String       @map("emission_factor_id") @db.Uuid
  methodology            Methodology
  inputValue             Decimal      @map("input_value") @db.Decimal(20, 6)
  inputUnit              String       @map("input_unit")
  normalizedValue        Decimal      @map("normalized_value") @db.Decimal(30, 12)
  normalizedUnit         String       @map("normalized_unit")
  factorValue            Decimal      @map("factor_value") @db.Decimal(30, 12)
  factorNumeratorUnit    Co2eUnit     @map("factor_numerator_unit")
  factorDenominatorUnit  String       @map("factor_denominator_unit")
  factorSource           String       @map("factor_source")
  factorVersion          Int          @map("factor_version")
  gwpSet                 String       @map("gwp_set")
  scope                  GhgScope
  ghgCategory            GhgCategory? @map("ghg_category")
  reportingPeriod        String       @map("reporting_period")
  resultValueTco2e       Decimal      @map("result_value_tco2e") @db.Decimal(20, 6)
  assumptions            Json         @default("{}")
  steps                  Json         @default("[]")
  factorSelectionReasons Json         @default("[]") @map("factor_selection_reasons")
  calculationVersion     String       @map("calculation_version")
  supersedesId           String?      @map("supersedes_id") @db.Uuid
  calculatedByUserId     String       @map("calculated_by_user_id") @db.Uuid
  calculatedAt           DateTime     @default(now()) @map("calculated_at") @db.Timestamptz(6)
  approvedByUserId       String?      @map("approved_by_user_id") @db.Uuid
  approvedAt             DateTime?    @map("approved_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity       ActivityData   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  emissionFactor EmissionFactor @relation(fields: [emissionFactorId], references: [id])
  supersedes     Calculation?   @relation("CalculationVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   Calculation[]  @relation("CalculationVersion")
  datapoints     Datapoint[]

  @@index([organizationId, scope, reportingPeriod])
  @@index([organizationId, activityId])
  @@map("calculation")
}

/// Rolled-up GHG-inventory total per (scope, category, period). A projection —
/// upserted from calculations by recomputeEmissions.
model Emission {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  scope                GhgScope
  ghgCategory          GhgCategory? @map("ghg_category")
  reportingPeriod      String       @map("reporting_period")
  valueTco2e           Decimal      @map("value_tco2e") @db.Decimal(20, 6)
  calculationCount     Int          @map("calculation_count")
  methodSummary        String       @map("method_summary")
  sourceCalculationIds String[]     @map("source_calculation_ids") @db.Uuid
  computedAt           DateTime     @default(now()) @map("computed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, ghgCategory, reportingPeriod])
  @@index([organizationId, reportingPeriod])
  @@map("emission")
}

model DatapointEvidence {
  organizationId String   @map("organization_id") @db.Uuid
  datapointId    String   @map("datapoint_id") @db.Uuid
  evidenceId     String   @map("evidence_id") @db.Uuid
  linkedByUserId String   @map("linked_by_user_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  datapoint Datapoint @relation(fields: [datapointId], references: [id], onDelete: Cascade)
  evidence  Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([datapointId, evidenceId])
  @@index([organizationId])
  @@index([evidenceId])
  @@map("datapoint_evidence")
}

model EvidenceVerification {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  evidenceId       String   @map("evidence_id") @db.Uuid
  method           String
  outcome          String
  verifiedByUserId String   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)
  notes            String?

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([organizationId, evidenceId])
  @@map("evidence_verification")
}

/// Versioned, append-only aggregated snapshot of a supplier's sustainability
/// profile (brief Module C). `data` is the PassportData from @trace/domain.
model SupplierPassport {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  version          Int
  builderVersion   String   @map("builder_version")
  completeness     Int
  data             Json
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  computedByUserId String?  @map("computed_by_user_id") @db.Uuid

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, version])
  @@index([organizationId, supplierId])
  @@map("supplier_passport")
}
