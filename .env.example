# ---------------------------------------------------------------------------
# TRACE environment. Copy to .env and fill in. Never commit .env.
# Parsed and validated by @trace/config (packages/config/src/env.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=4000
# Public origin of the web app, used for magic-link URLs and CORS.
WEB_ORIGIN=http://localhost:3000
# 32+ char secret for signing session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-long-random-value-min-32-chars
# Session lifetime.
SESSION_TTL_HOURS=12
# Magic-link token lifetime.
MAGIC_LINK_TTL_MINUTES=15

# --- Database ---
# A PostgreSQL 16 instance. Local Docker: postgres://trace:trace@localhost:5432/trace
# Hosted (no Docker): paste a Neon/Supabase/Railway EU connection string.
DATABASE_URL=postgresql://trace:trace@localhost:5432/trace?schema=public
# Separate URL used by integration tests (may be the same server, different db).
DATABASE_URL_TEST=postgresql://trace:trace@localhost:5432/trace_test?schema=public

# --- Redis (background jobs) ---
REDIS_URL=redis://localhost:6379

# --- Object storage ---
# 'local' stores documents on disk under STORAGE_LOCAL_DIR (dev default).
# 's3' uses an S3-compatible bucket (set the STORAGE_* values below).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/documents
STORAGE_SIGNING_SECRET=replace-me-with-a-random-value-min-16-chars
DOCUMENT_MAX_BYTES=26214400
# S3-compatible (EU region). Only used when STORAGE_DRIVER=s3.
STORAGE_ENDPOINT=
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=trace-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# --- AI provider (Anthropic) ---
# auto = use Claude when ANTHROPIC_API_KEY is set, else a deterministic dev stub
# (heuristic extraction, clearly labelled — never presented as AI output).
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL_EXTRACTION=claude-sonnet-5
AI_MODEL_CLASSIFICATION=claude-haiku-4-5

# --- Observability ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Email (magic links) ---
# Phase 1 dev: 'console' prints the link to the API log. 'smtp' uses the settings below.
EMAIL_TRANSPORT=console
SMTP_URL=
EMAIL_FROM=no-reply@trace.local
