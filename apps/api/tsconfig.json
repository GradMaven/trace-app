{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Restated locally (not only inherited) so the API always compiles strict
    // even if a build runs it where the `extends` chain can't be resolved —
    // without `strictNullChecks`, `z.infer` widens every field to optional.
    "strict": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts"]
}
